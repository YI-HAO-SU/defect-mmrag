# Copy to .env and edit as needed. All values have safe defaults in src/config.py.
# On Linux/Mac this file is auto-created by `make up` or `./start.sh`.

# HuggingFace token — required only for gated models (Llama, Gemma, etc.).
# Qwen2.5-VL is open, so this can stay empty.
HF_TOKEN=

# Host path to HuggingFace model cache (mounted into the vLLM container).
# Linux/Mac: leave as-is (Makefile/start.sh sets it to $HOME/.cache/huggingface)
# Windows:   set to %USERPROFILE%\.cache\huggingface
# Windows: C:/Users/<your-name>/.cache/huggingface
# Linux/Mac: /home/<your-name>/.cache/huggingface
HF_CACHE_DIR=

# Vector DB
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=defect_cases

# Embedding
EMBEDDING_MODEL_ID=google/siglip-base-patch16-224
EMBEDDING_DIM=768

# VLM
VLM_MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct
VLLM_BASE_URL=http://localhost:8000/v1

# RAG
RETRIEVAL_TOP_K=2
GENERATION_MAX_TOKENS=512
GENERATION_TEMPERATURE=0.3
